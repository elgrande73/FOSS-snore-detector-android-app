<?xml version="1.0" encoding="utf-8"?><!--
   Android Auto Backup for Android 12+ (see backup_rules.xml for older versions).
   Only the settings may go to the cloud backup; snoring history and recordings stay on the device
   unless the user saves them through Settings > Backup & Restore.
   Device-to-device transfer is not restricted: it goes directly to the user's new phone.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="sharedpref" path="snore_detector_preferences.xml" />
    </cloud-backup>
</data-extraction-rules>
